# -------------------------------------------------
# OrchardCraft Project – Comprehensive .gitignore
# -------------------------------------------------
# OS / system files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
Icon?

# Node / npm
node_modules/
package-lock.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log

# Build / distribution artifacts (if any)
/dist
/build
/.parcel-cache
/.vite
/.next

# Logs & debugging
*.log
log/

# IDE / editor specific files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.swp
*~

# Environment files
.env
.env.*

# Personal data / secrets
*.key
*.pem
*.crt

# Temporary / cache files
.tmp
.cache

# Files generated by the http-server when testing (if any)
*.tgz

# Ignore the .agents directory (contains tool-specific configs)
.agents/

# Ignore Claude related cache directory
.claude/

# Lock files for the repository tooling
skills-lock.json